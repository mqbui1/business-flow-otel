# Splunk REST API auth token (read path) — used by the backend to run SPL
# searches via /services/search/jobs. NOT the same as the HEC token used by
# the OTel Collector (see otel-collector/.env.example) — a HEC token cannot
# run searches, and this token cannot be used as a HEC token.
# Create via: Settings > Tokens (or `curl -k -u user:pass https://<host>:8089/services/auth/login`
# for a session token). Needs search capability on SPLUNK_INDEX below.
SPLUNK_TOKEN=

# Splunk management/REST API base URL (port 8089 by default), not the HEC port.
SPLUNK_BASE_URL=https://localhost:8089

# Index the milestone data lands in (must match otel-collector/.env.example's
# SPLUNK_HEC_INDEX).
SPLUNK_INDEX=business_milestones

VERIFY_TLS=true
