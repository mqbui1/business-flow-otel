# HTTP Event Collector (HEC) token (write path) — used by the splunkhecexporter
# to ingest milestone OTLP log records into Splunk. NOT the same as the
# Splunk REST API auth token used by the backend (see backend/.env.example) —
# this token can only write data, it cannot run searches.
# Create via: Settings > Data Inputs > HTTP Event Collector > New Token.
SPLUNK_HEC_TOKEN=

# HEC endpoint, e.g. https://http-inputs-<host>.splunkcloud.com/services/collector
# (different host/port than the REST API base URL used by the backend).
SPLUNK_HEC_ENDPOINT=

# Index the HEC token is allowed to write to (must match backend/.env.example's
# SPLUNK_INDEX).
SPLUNK_HEC_INDEX=business_milestones
